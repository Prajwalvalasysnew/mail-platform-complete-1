# Production environment template.
# Copy to a secret-managed environment, replace every value, and never commit
# the filled file. Values containing "replace" or "change-me" intentionally fail
# the production config guard.

NODE_ENV=production

# Internal service URLs. Prefer private networking/VPC DNS in production.
# Separate database roles are mandatory for fail-closed RLS:
# - API: non-superuser, non-BYPASSRLS
# - service: BYPASSRLS for worker/tracker/Haraka cross-tenant processing
# - migration: schema owner/DDL role, never used by an app process
API_DATABASE_URL=postgresql://mail_api:replace-with-api-db-password@postgres:5432/mail_platform
SERVICE_DATABASE_URL=postgresql://mail_service:replace-with-service-db-password@postgres:5432/mail_platform
MIGRATION_DATABASE_URL=postgresql://mail_migrator:replace-with-migration-db-password@postgres:5432/mail_platform
POSTGRES_PASSWORD=replace-with-real-db-password
REDIS_PASSWORD=replace-with-real-redis-password
REDIS_HOST=redis
REDIS_PORT=6379
HARAKA_OUTBOUND_PASS=replace-with-real-internal-smtp-password

# API and identity secrets. Generate independent random values for each.
# Suggested commands:
#   openssl rand -hex 32
#   openssl rand -base64 48
JWT_SECRET=replace-with-random-32-plus-char-secret
ENCRYPTION_KEY=replace-with-64-hex-chars-from-openssl-rand-hex-32
VERP_SECRET=replace-with-random-verp-signing-secret
API_KEY_PEPPER=replace-with-random-api-key-pepper
ADMIN_SESSION_PEPPER=replace-with-random-admin-session-pepper
USER_SESSION_PEPPER=replace-with-random-user-session-pepper
MFA_RECOVERY_PEPPER=replace-with-random-mfa-recovery-pepper
ADMIN_TOKEN=replace-with-random-break-glass-admin-token
METRICS_TOKEN=replace-with-random-prometheus-scrape-token
ADMIN_PASSWORD_LOGIN_DISABLED=true

# Public domains.
PLATFORM_DOMAIN=mail.example.com
APP_BASE_URL=https://app.example.com
TRACKING_DOMAIN=https://track.example.com
BOUNCE_DOMAIN=bounces.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

# Delivery. SES is recommended for launch; Haraka requires IP warmup, PTR,
# postmaster registrations, and abuse operations.
DELIVERY_TRANSPORT=ses
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=replace-with-ses-smtp-user
SES_SMTP_PASS=replace-with-ses-smtp-password
SES_MAX_CONNECTIONS=10

# DKIM and key management.
DKIM_REQUIRED=true
KMS_PROVIDER=env
# For enterprise deployments, prefer aws/gcp/vault and provide the matching
# encrypted master key env var documented in docs/PRODUCTION_CHECKLIST.md.

# Runtime limits.
API_RATE_LIMIT_PER_MINUTE=1000
SEND_RATE_LIMIT_PER_MINUTE=300
SEND_QUEUE_BACKPRESSURE=100000
WORKER_CONCURRENCY=50
WORKER_METRICS_PORT=9100

# Optional integrations.
STRIPE_WEBHOOK_SECRET=
# Required only with BILLING_PROVIDER=paypal and live PayPal credentials.
PAYPAL_WEBHOOK_ID=replace-with-paypal-webhook-id
OIDC_ISSUER_URL=https://idp.example.com
OIDC_CLIENT_ID=replace-with-oidc-client-id
OTEL_EXPORTER_OTLP_ENDPOINT=
STATUS_HEARTBEAT_URL=
