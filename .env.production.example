# Production environment template.
# Copy to a secret-managed environment, replace every value, and never commit
# the filled file. Values containing "replace" or "change-me" intentionally fail
# the production config guard.

NODE_ENV=production

# Internal service URLs. Prefer private networking/VPC DNS in production.
# Separate database roles are mandatory for fail-closed RLS:
# - API: non-superuser, non-BYPASSRLS
# - service: BYPASSRLS for worker/tracker/Haraka cross-tenant processing
# - migration: schema owner/DDL role, never used by an app process
API_DATABASE_URL=postgresql://mail_api:replace-with-api-db-password@postgres:5432/mail_platform
SERVICE_DATABASE_URL=postgresql://mail_service:replace-with-service-db-password@postgres:5432/mail_platform
MIGRATION_DATABASE_URL=postgresql://mail_migrator:replace-with-migration-db-password@postgres:5432/mail_platform
POSTGRES_PASSWORD=replace-with-real-db-password
REDIS_PASSWORD=replace-with-real-redis-password
REDIS_HOST=redis
REDIS_PORT=6379
HARAKA_OUTBOUND_PASS=replace-with-real-internal-smtp-password

# API and identity secrets. Generate independent random values for each.
# Suggested commands:
#   openssl rand -hex 32
#   openssl rand -base64 48
JWT_SECRET=replace-with-random-32-plus-char-secret
ENCRYPTION_KEY=replace-with-64-hex-chars-from-openssl-rand-hex-32
VERP_SECRET=replace-with-random-verp-signing-secret
API_KEY_PEPPER=replace-with-random-api-key-pepper
ADMIN_SESSION_PEPPER=replace-with-random-admin-session-pepper
USER_SESSION_PEPPER=replace-with-random-user-session-pepper
MFA_RECOVERY_PEPPER=replace-with-random-mfa-recovery-pepper
ADMIN_TOKEN=replace-with-random-break-glass-admin-token
METRICS_TOKEN=replace-with-random-prometheus-scrape-token
ADMIN_PASSWORD_LOGIN_DISABLED=true

# Independent signed audit checkpoints. The bucket must have Object Lock
# enabled; the worker writes every checkpoint in COMPLIANCE retention mode.
AUDIT_SIGNING_KEY_PEM=replace-with-base64-or-multiline-secret-managed-ed25519-private-key
AUDIT_WORM_PROVIDER=s3
AUDIT_WORM_S3_BUCKET=replace-with-object-lock-enabled-bucket
AUDIT_WORM_S3_KMS_KEY_ID=replace-with-independent-audit-kms-key-id
AUDIT_WORM_S3_REGION=eu-central-1
AUDIT_WORM_RETENTION_DAYS=2557
AUDIT_WORM_EXPORT_INTERVAL_MS=300000

# Public domains.
PLATFORM_DOMAIN=mail.example.com
APP_BASE_URL=https://app.example.com
TRACKING_DOMAIN=https://track.example.com
BOUNCE_DOMAIN=bounces.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

# Delivery. SES is recommended for launch; Haraka requires IP warmup, PTR,
# postmaster registrations, and abuse operations.
DELIVERY_TRANSPORT=ses
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=replace-with-ses-smtp-user
SES_SMTP_PASS=replace-with-ses-smtp-password
SES_MAX_CONNECTIONS=10

# Customer-facing SMTP submission gateway (smart host). STARTTLS is mandatory
# in production because customers send their API key over the wire as the SMTP
# password — the gateway refuses to boot without these unless
# SMTP_ALLOW_INSECURE_AUTH=true is set to consciously accept plaintext auth.
# Point these at the mounted TLS key/cert for smtp.<your-domain>.
SMTP_TLS_KEY_FILE=/etc/mailplatform/tls/smtp.key
SMTP_TLS_CERT_FILE=/etc/mailplatform/tls/smtp.crt
SMTP_MAX_CLIENTS=1000
SMTP_MAX_RECIPIENTS=100
SMTP_MAX_MESSAGES_PER_CONNECTION=100
SMTP_IP_CONNECTIONS_PER_MINUTE=120
SMTP_FREE_MESSAGES_PER_MINUTE=60
SMTP_PAID_MESSAGES_PER_MINUTE=600
SMTP_ENTERPRISE_MESSAGES_PER_MINUTE=3000
SMTP_SOCKET_TIMEOUT_MS=300000
SMTP_CLOSE_TIMEOUT_MS=10000

# Regulated deployments fail closed when the scanner is unavailable. The
# ClamAV service must enforce archive recursion and decompression-size limits.
ATTACHMENT_SCANNER=clamav
ATTACHMENT_SCAN_REQUIRED=true
ATTACHMENT_SCAN_FAILURE_POLICY=reject
ATTACHMENT_SCAN_TIMEOUT_MS=10000
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# DKIM and key management.
DKIM_REQUIRED=true
KMS_PROVIDER=aws
AWS_REGION=us-east-1
AWS_KMS_ENCRYPTED_KEY=replace-with-base64-aws-kms-ciphertext
# Vault Transit is also supported. KMS_PROVIDER=env is refused in production
# unless KMS_ALLOW_ENV_IN_PRODUCTION=true explicitly records a single-host
# exception. Haraka still consumes ENCRYPTION_KEY for DKIM; isolate that
# container secret until its plugin supports remote KMS directly.

# Runtime limits.
API_RATE_LIMIT_PER_MINUTE=1000
SEND_RATE_LIMIT_PER_MINUTE=300
SEND_QUEUE_BACKPRESSURE=100000
WORKER_CONCURRENCY=50
WORKFLOW_DEFINITION_CACHE_MAX=10000
WORKER_METRICS_PORT=9100
RETENTION_DMARC_DAYS=365

# Optional integrations.
STRIPE_WEBHOOK_SECRET=
# Required only with BILLING_PROVIDER=paypal and live PayPal credentials.
PAYPAL_WEBHOOK_ID=replace-with-paypal-webhook-id
OIDC_ISSUER_URL=https://idp.example.com
OIDC_CLIENT_ID=replace-with-oidc-client-id
# Every admin token must prove this IdP authentication context (AMR or ACR).
OIDC_REQUIRED_AUTH_CONTEXT=mfa
SEC_ARCHIVE_URL=https://archive-provider.example.com/v1/communications
SEC_ARCHIVE_TOKEN=replace-with-specialist-archive-token
OTEL_EXPORTER_OTLP_ENDPOINT=
STATUS_HEARTBEAT_URL=

# ===================
# Privacy erasure pseudonymization (BASE-03)
# Keyed HMAC pseudonyms for erased recipient identifiers retained as
# opt-out/erasure evidence. Optional: falls back to ENCRYPTION_KEY.
# Rotating/destroying this key renders retained pseudonyms unverifiable.
# ===================
#PRIVACY_PSEUDONYM_SECRET=replace-with-random-string-min-16-chars
