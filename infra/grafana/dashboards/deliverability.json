{
  "title": "Mail Platform — Deliverability",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "5m",
  "uid": "mp-deliverability",
  "tags": ["mail-platform", "deliverability"],
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "pool",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(mp_pool_bounce_rate, pool)",
        "multi": true,
        "includeAll": true,
        "label": "IP Pool"
      }
    ]
  },
  "panels": [
    {
      "title": "Bounce rate by pool (rolling 24h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "mp_pool_bounce_rate{pool=~\"$pool\"}", "legendFormat": "{{pool}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 0.15,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green" }, { "color": "yellow", "value": 0.05 }, { "color": "red", "value": 0.10 }]
          }
        }
      }
    },
    {
      "title": "Complaint rate by pool (rolling 24h)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "mp_pool_complaint_rate{pool=~\"$pool\"}", "legendFormat": "{{pool}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 0.01,
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green" }, { "color": "yellow", "value": 0.002 }, { "color": "red", "value": 0.005 }]
          }
        }
      }
    },
    {
      "title": "Delivery funnel (last 24h)",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "options": { "orientation": "horizontal", "displayMode": "gradient", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "expr": "increase(mp_messages_accepted_total[24h])", "legendFormat": "Accepted" },
        { "expr": "increase(mp_messages_sent_total[24h])", "legendFormat": "Sent" },
        { "expr": "increase(mp_messages_delivered_total[24h])", "legendFormat": "Delivered" },
        { "expr": "increase(mp_messages_bounced_total[24h])", "legendFormat": "Bounced" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 }
      }
    },
    {
      "title": "Blocklist listings by provider",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "mp_blocklist_listings", "legendFormat": "{{provider}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }]
          }
        }
      }
    },
    {
      "title": "Unsubscribe rate (24h rolling)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "rate(mp_messages_unsubscribed_total[1h]) / (rate(mp_messages_delivered_total[1h]) + 0.001)",
          "legendFormat": "unsub rate"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "min": 0 }
      }
    },
    {
      "title": "Google Postmaster — domain reputation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "description": "Requires GOOGLE_POSTMASTER_SA_KEY_JSON to be configured. Data refreshed daily.",
      "targets": [
        { "expr": "mp_postmaster_domain_reputation", "legendFormat": "{{domain}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "max": 4,
          "mappings": [
            { "type": "value", "options": { "0": { "text": "BAD" }, "1": { "text": "LOW" }, "2": { "text": "MEDIUM" }, "3": { "text": "HIGH" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "red" }, { "color": "orange", "value": 1 }, { "color": "yellow", "value": 2 }, { "color": "green", "value": 3 }]
          }
        }
      }
    },
    {
      "title": "DKIM sign failures",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 24 },
      "targets": [
        { "expr": "rate(mp_dkim_sign_failures_total[5m])", "legendFormat": "failures/s" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "color": { "mode": "fixed", "fixedColor": "red" } }
      }
    },
    {
      "title": "IP warmup stages",
      "type": "table",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 24 },
      "targets": [
        { "expr": "mp_ip_warmup_stage", "legendFormat": "{{ip}}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0 }
      }
    },
    {
      "title": "Metering drift (billing reconciliation)",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 24 },
      "targets": [
        { "expr": "mp_metering_drift", "legendFormat": "drift" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green" }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 100 }]
          }
        }
      }
    }
  ]
}
