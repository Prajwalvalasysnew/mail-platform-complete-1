{
  "name": "mail-platform",
  "version": "0.7.23",
  "private": true,
  "description": "Self-hosted multi-tenant transactional email platform",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@platform/shared && npm run build --workspace=@platform/api && npm run build --workspace=@platform/worker && npm run build --workspace=@platform/tracker && npm run build --workspace=@platform/smtp-gateway && npm run build --workspace=@platform/sdk && npm run build --workspace=@platform/customer-ui",
    "dev:api": "node --env-file=.env --import tsx --watch packages/api/src/bootstrap.ts",
    "dev:admin": "npm run dev --workspace=@platform/admin-console",
    "build:admin": "npm run build --workspace=@platform/admin-console",
    "dev:customer": "npm run dev --workspace=@platform/customer-ui",
    "build:customer": "npm run build --workspace=@platform/customer-ui",
    "dev:landing": "npm run dev --workspace=@platform/landing-page",
    "build:landing": "npm run build --workspace=@platform/landing-page",
    "start:landing": "npm run start --workspace=@platform/landing-page",
    "dev:worker": "npm run dev --workspace=@platform/worker",
    "dev:ai": "node --env-file=.env --import tsx packages/worker/src/ai-worker.ts",
    "dev:tracker": "npm run dev --workspace=@platform/tracker",
    "migrate": "tsx packages/shared/src/bin/migrate.ts",
    "migrate:baseline": "tsx packages/shared/src/bin/migrate.ts --baseline-existing",
    "seed": "tsx scripts/seed.ts",
    "dkim:generate": "bash scripts/generate-dkim.sh",
    "test": "npm run test --workspace=@platform/tests",
    "test:e2e": "npm run test:e2e --workspace=@platform/tests",
    "test:coverage": "node scripts/test-with-coverage.mjs",
    "create-admin": "tsx packages/shared/src/bin/create-admin.ts",
    "backup-drill": "bash scripts/backup-restore-drill.sh",
    "dev:docs": "npm run start --workspace=@platform/docs",
    "build:docs": "npm run build --workspace=@platform/docs",
    "export-openapi": "tsx packages/shared/src/bin/export-openapi.ts",
    "prod:check": "node scripts/production-readiness-check.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "serialize-javascript": "6.0.2",
    "copy-webpack-plugin": {
      "serialize-javascript": "6.0.2"
    },
    "css-minimizer-webpack-plugin": {
      "serialize-javascript": "6.0.2"
    },
    "protobufjs": "7.6.5",
    "tar": "7.5.22",
    "find-my-way": "9.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "1.1.4",
    "@rollup/rollup-win32-x64-msvc": "4.62.2"
  }
}
