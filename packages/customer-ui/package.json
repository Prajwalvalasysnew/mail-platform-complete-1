{
  "name": "@platform/customer-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Valasys Mail customer application",
  "scripts": {
    "design:compile": "node scripts/compile-design.mjs",
    "test:design": "node scripts/check-design.mjs",
    "test:interactions": "node scripts/check-interactions.mjs",
    "predev": "npm run design:compile",
    "dev": "vite",
    "build": "npm run design:compile && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@reduxjs/toolkit": "^2.13.0",
    "@tanstack/react-query": "^5.59.0",
    "grapesjs": "^0.23.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.4",
    "parse5": "^7.3.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.4.0",
    "vite": "^8.1.5"
  }
}
