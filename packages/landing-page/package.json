    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@playwright/test": "^1.64.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "parse5": "^7.3.0",
    "typescript": "^5.9.3"
